<Window x:Class="WinClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinClip"
        x:ClassModifier="internal"
        Title="WinClip settings" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="Shortcut" Style="{StaticResource Label}" />
        <local:HotkeyRecorder x:Name="Recorder" />
        <TextBlock Text="Opens clipboard history from any app." Style="{StaticResource Help}" />

        <Grid Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="History size" Style="{StaticResource Label}" />
                <TextBox x:Name="MaxItems" Style="{StaticResource Field}" AutomationProperties.Name="History size" />
                <TextBlock Text="Items to keep. Pinned items don't count." Style="{StaticResource Help}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Longest copy to keep" Style="{StaticResource Label}" />
                <TextBox x:Name="MaxItemLength" Style="{StaticResource Field}" AutomationProperties.Name="Longest copy to keep" />
                <TextBlock Text="In characters. Longer copies are skipped." Style="{StaticResource Help}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Never record copies from" Style="{StaticResource Label}" Margin="0,26,0,8" />
        <TextBox x:Name="IgnoredApps" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="NoWrap"
                 Height="128" VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="Never record copies from" />
        <TextBlock Style="{StaticResource Help}"
                   Text="One app per line, as named in Task Manager's Details tab. Copies that password managers mark as private are always skipped." />

        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Style="{StaticResource Toggle}" Margin="0,26,0,0" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Error}" FontSize="13" TextWrapping="Wrap"
                   Margin="0,20,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
