<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinClip.Core\WinClip.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>WinClip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regenerate with scripts/make-icon.ps1. Embedded again for the tray, which needs it at runtime. -->
    <EmbeddedResource Include="WinClip.ico" LogicalName="WinClip.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of global usings so WPF types (Application, Clipboard, Point...) stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
