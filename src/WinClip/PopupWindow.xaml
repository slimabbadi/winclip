<Window x:Class="WinClip.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WinClip" Width="460" Height="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="16,0,16,0" Height="50">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="Placeholder" Text="Search clipboard history" FontSize="15"
                       Foreground="{StaticResource Muted}" Margin="28,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
            <TextBox x:Name="SearchBox" FontSize="15" Margin="25,0,0,0" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource Accent}"
                     AutomationProperties.Name="Search clipboard history"
                     TextChanged="OnSearchChanged" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Hairline}" />

        <ListBox x:Name="Clips" Grid.Row="2" Padding="0,6" Focusable="False"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 PreviewMouseLeftButtonDown="OnClipPressed"
                 PreviewMouseLeftButtonUp="OnClipClicked"
                 AutomationProperties.Name="Clipboard history">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Margin="6,1">
                                    <Border x:Name="Fill" Background="Transparent" CornerRadius="6" />
                                    <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9"
                                            CornerRadius="1.5" Background="{StaticResource Accent}" Visibility="Collapsed" />
                                    <ContentPresenter />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Raised}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Selection}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Shortcut}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <Border x:Name="ThumbFrame" Visibility="{Binding ThumbnailVisibility}" HorizontalAlignment="Left"
                                    CornerRadius="4" ClipToBounds="True" Margin="0,1,0,6"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                <Image x:Name="Thumb" Source="{Binding Thumbnail}" MaxHeight="36" MaxWidth="340" Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <DockPanel x:Name="Line">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Margin="0,2,8,0" Foreground="{StaticResource Muted}"
                                           Visibility="{Binding GlyphVisibility}" />
                                <TextBlock Text="{Binding Preview}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="Full" Text="{Binding Expanded}" FontSize="13.5" Visibility="Collapsed"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="76" />
                            <TextBlock x:Name="Origin" Text="{Binding Origin}" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,1,0,0">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,6,0"
                                       Foreground="{StaticResource Pin}" Visibility="{Binding PinVisibility}"
                                       ToolTip="Pinned" />
                            <TextBlock Text="{Binding Age}" FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Thumb" Property="MaxHeight" Value="120" />
                            <Setter TargetName="Full" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Origin" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyState" Grid.Row="2" FontSize="13.5" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="300" Visibility="Collapsed" />

        <Border Grid.Row="3" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Hints" FontSize="12" Foreground="{StaticResource Muted}" Margin="16,10" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
